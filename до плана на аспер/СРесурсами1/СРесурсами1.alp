						<Parameter>
							<Name><![CDATA[onPrepareUnit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Работник работник = (Работник)unit;

// базовое время выполнения, ч. Калибровка под загрузку ~80%:
// при 0.0886 прогон на 250 дней дал загрузку ~100% (выполнено 92% заданий, очередь росла);
// 0.0886 x 0.74 = 0.066 -> ~80%. ДОПУЩЕНИЕ, подобрано под загрузку, не норматив;
// пересчитать после удаления психотипов (уйдёт их средний множитель ~1.18)
// здоровье отдельно не делим: оно уже входит в продуктивность
agent.назначенноеВремяДэлэйПоДанномуСотруднику = Math.max(
    0.066 * agent.сложность / Math.max(работник.продуктивность, 0.01),
    0.1);

// совпадение психотипа с типом задания
boolean совпадение =
    (работник.психотип == 1 && agent.типЗадания == ТипЗадания.аналитическое) ||
    (работник.психотип == 2 && agent.типЗадания == ТипЗадания.регламентное)  ||
    (работник.психотип == 3 && agent.типЗадания == ТипЗадания.управленческое)||
    (работник.психотип == 4 && agent.типЗадания == ТипЗадания.творческое);

if (совпадение) {
    agent.назначенноеВремяДэлэйПоДанномуСотруднику *= 0.7; // быстрее
    работник.накопленнаяУсталость -= 0.0; // психотипы: влияние на усталость выключено (было -0.05)
    работник.накопленнаяУсталость = Math.max(работник.накопленнаяУсталость, 0);
} else {
    agent.назначенноеВремяДэлэйПоДанномуСотруднику *= 1.3; // медленнее
    работник.накопленнаяУсталость += 0.0; // психотипы: влияние на усталость выключено (было +0.1)
}
]]></Code>
							</Value>
						</Parameter>
