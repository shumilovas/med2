			<Events>
				<Event>
					<Id>1779447176707</Id>
					<Name><![CDATA[СуммированиеЗарплатИУсталости]]></Name>
					<X>280</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779523200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!inState(заболел) && main.расписаниеПерерывов.getValue() == false && накопленнаяУсталость < 101) {
    суммаЗарплат += зарплата;
    // масштабУтомления (Main) подбирается так, чтобы без программы выгорало ~15%; ДОПУЩЕНИЕ
    накопленнаяУсталость += 0.003*коэффициентУтомления * main.кадроваяНагрузка * main.масштабУтомления;
    
    накопленнаяУсталость = Math.max(накопленнаяУсталость - 0.0005, 0);
}
]]></Action>
				</Event>
				<Event>
					<Id>1779900568623</Id>
					<Name><![CDATA[расчетПремииЗаФизАкт]]></Name>
					<X>490</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779955200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (участвуетВПрограмме && уровеньАктивности > 0) {
        double годоваяПремия = main.базовыйРазмерГодовойПремииЗаФизическуюАктивность;
        double периодВыплат = main.периодичностьВыплатПремииЗаФизАктивность;
        премияЗаАктивность = годоваяПремия / периодВыплат;
       
    } else {
        премияЗаАктивность = 0;
      
    }]]></Action>
				</Event>
				<Event>
					<Id>1779901770946</Id>
					<Name><![CDATA[пересчетПроизводительностиПриВыгорании]]></Name>
					<X>290</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779955200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[2]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Продуктивность считается от ТЕКУЩЕГО состояния, а не накопительно:
// при снижении усталости и восстановлении здоровья работник восстанавливается
double доляПотерьОтБолезней = (суммаЗарплат > 0)
    ? Math.min(суммаБольничных / суммаЗарплат, 0.5)
    : 0;
// адаптация нового сотрудника: с 50% до 100% за 90 дней; ДОПУЩЕНИЕ
double адаптация = Math.min(1.0, 0.5 + 0.5 * (time() - когдаВзятНаРаботу) / 90.0);
double новаяПродуктивность = базоваяПродуктивность * адаптация
    * Math.max(1 - накопленнаяУсталость / 100, 0)
    * Math.min(здоровье, 1.0)
    * (1 - доляПотерьОтБолезней);
продуктивность = Math.max(новаяПродуктивность, 0.05);]]></Action>
				</Event>
				<Event>
					<Id>1779903991614</Id>
					<Name><![CDATA[обновитьСостояние]]></Name>
					<X>60</X><Y>340</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779955200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[19]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[10]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Влияние здоровья на накопление усталости
        if (здоровье > 0.85) {
            коэффициентУтомления = 0.95;
        } else if (здоровье < 0.70) {
            коэффициентУтомления = 1.03;
        } else {
            коэффициентУтомления = 1.0;
        }

        // Влияние усталости на здоровье (нижняя граница 0.05)
        // плавная зависимость вместо обрыва -0.2/-0.5 за 10 дней:
        // выше порога 15 здоровье снижается пропорционально превышению
        // ДОПУЩЕНИЕ: 0.0005 за единицу превышения за 10 дней (было 0.002)
        if (накопленнаяУсталость > 15) {
            здоровье = Math.max(здоровье - 0.0005 * (накопленнаяУсталость - 15), 0.05);
        }]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1779889391545</Id>
					<Name><![CDATA[рассчитатьПремиюЗаФизическуюАктивность]]></Name>
					<X>460</X><Y>410</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (участвуетВПрограмме && уровеньАктивности > 0) {
        double годоваяПремия = main.базовыйРазмерГодовойПремииЗаФизическуюАктивность;
        double периодВыплат = main.периодичностьВыплатПремииЗаФизАктивность;
        премияЗаАктивность = годоваяПремия / периодВыплат;
        return годоваяПремия / периодВыплат;
    } else {
        премияЗаАктивность = 0;
        return 0;
    }]]></Body>
				</Function>
			</Functions>
