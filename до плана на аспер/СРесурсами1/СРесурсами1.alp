		<ActiveObjectClass>
			<Id>1775594893255</Id>
			<Name><![CDATA[Main]]></Name>
			<AdditionalClassCode><![CDATA[// Объявляем все узлы как тип Node (это подходит и для RectangularNode, и для PointNode)
Node nodeHotKitchen = горячийЦех;
Node nodeServing = раздаточная;
Node nodeDining = ОбеденныйЗал;
Node nodeEntrance = вход;
Node nodeWardFar = палаты3_4;

// Расстояния (в метрах, с учётом коэффициента)
double времяДоставкиЕды = 0.0;      // расстояние от раздачи до зала
double путьПациента = 0.0;          // расстояние для маршрута пациента
double дневнойПробегПовара = 0.0;  // расстояние для пробега персонала

// Статусы валидации (true/false)
boolean статусЕда = false;
boolean статусПациент = false;
boolean статусПерсонал = false;
]]></AdditionalClassCode>
			<StartupCode><![CDATA[// --- ИНИЦИАЛИЗАЦИЯ УЗЛОВ (Выполнить при старте модели) ---

    
    // Привязываем наши переменные к реальным объектам на схеме
    nodeHotKitchen = горячийЦех;
    nodeServing = раздаточная;
    nodeDining = ОбеденныйЗал;
    nodeEntrance = вход;
    nodeWardFar = палаты3_4;
    
    traceln("=== УЗЛЫ УСПЕШНО ИНИЦИАЛИЗИРОВАНЫ ===");
    traceln("Горячий цех: " + (nodeHotKitchen != null ? "OK" : "NULL"));
    traceln("Раздача: " + (nodeServing != null ? "OK" : "NULL"));
    traceln("Обеденный зал: " + (nodeDining != null ? "OK" : "NULL"));

]]></StartupCode>
