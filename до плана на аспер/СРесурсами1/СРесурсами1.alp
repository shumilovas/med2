						<Parameter>
							<Name><![CDATA[onNewUnit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[unit.здоровье = triangular(0.3, 1.3, 0.8);
unit.продуктивность = triangular(0.3, 1.3, 0.8);
unit.базоваяПродуктивность = unit.продуктивность;]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onDestroyUnit]]></Name>
						</Parameter>
