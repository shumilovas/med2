				<Event>
					<Id>1779889843360</Id>
					<Name><![CDATA[РасчетПремийЗаФизАктив]]></Name>
					<X>50</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1779955200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MONTH]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[365/периодичностьВыплатПремииЗаФизАктивность]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[
        if (системаПРемированияЗаФизАктивность) {
            double общаяСуммаПремий = 0;
            
            for (Работник r : работники) {
                r.рассчитатьПремиюЗаФизическуюАктивность(); // рассчитываем премию внутри работника
                общаяСуммаПремий += r.премияЗаАктивность;
            }
            
            суммаЗарплат += общаяСуммаПремий;
            
        }
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781864569361</Id>
					<Name><![CDATA[validateLayout]]></Name>
					<X>180</X><Y>1160</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[    traceln("\n=== ЗАПУСК ПРОВЕРКИ МАРШРУТОВ ===");

    // 1. Маршрут еды: Раздача -> Обеденный зал
    // Используем наши переменные-ссылки и универсальную функцию
    времяДоставкиЕды = getRouteDist(nodeServing, nodeDining);
    
    if (времяДоставкиЕды > 0) {
        traceln("[ЕДА] Путь от раздачи до зала: " + String.format("%.2f", времяДоставкиЕды) + " м");
    } else {
        traceln("[ЕДА] Не удалось рассчитать путь (проверьте узлы).");
    }

    // 2. Маршрут пациента: Вход -> Палаты
    путьПациента = getRouteDist(nodeEntrance, nodeWardFar);
    
    if (путьПациента > 0) {
        traceln("[ПАЦИЕНТ] Путь пациента: " + String.format("%.2f", путьПациента) + " м");
    } else {
        traceln("[ПАЦИЕНТ] Не удалось рассчитать путь.");
    }

    // 3. Маршрут персонала: Горячий цех -> Раздача
    double oneWayStaff = getRouteDist(nodeHotKitchen, nodeServing);
    
    if (oneWayStaff > 0) {
        дневнойПробегПовара = oneWayStaff * 2 * 10; // Пример: 10 рейсов за смену
        traceln("[ПЕРСОНАЛ] Оценочный пробег повара за смену: " + String.format("%.2f", дневнойПробегПовара) + " м");
    } else {
        traceln("[ПЕРСОНАЛ] Не удалось рассчитать путь.");
    }
    
    traceln("=== КОНЕЦ ПРОВЕРКИ ===\n");

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781882074936</Id>
					<Name><![CDATA[getNodeX]]></Name>
					<X>300</X><Y>1170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[n]]></Name>
						<Type><![CDATA[Node]]></Type>
					</Parameter>
					<Body><![CDATA[if (n == null) return 0;
    
    // Проверяем тип узла и получаем координаты
    if (n instanceof RectangularNode) {
        return ((RectangularNode) n).getX();
    } else if (n instanceof PointNode) {
        return ((PointNode) n).getX();
    }
    return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781882904570</Id>
					<Name><![CDATA[getNodeY]]></Name>
					<X>300</X><Y>1170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[n]]></Name>
						<Type><![CDATA[Node]]></Type>
					</Parameter>
					<Body><![CDATA[if (n == null) return 0;
    
    // Проверяем тип узла и получаем координаты
    if (n instanceof RectangularNode) {
        return ((RectangularNode) n).getY();
    } else if (n instanceof PointNode) {
        return ((PointNode) n).getY();
    }
    return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781950840849</Id>
					<Name><![CDATA[getRouteDist]]></Name>
					<X>390</X><Y>1170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nodeA]]></Name>
						<Type><![CDATA[Node]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nodeB]]></Name>
						<Type><![CDATA[Node]]></Type>
					</Parameter>
					<Body><![CDATA[if (nodeA == null || nodeB == null) {
    traceln("ОШИБКА в getRouteDist: Один из узлов равен null! Проверьте инициализацию.");
    return -1.0;
}

double scaleFactor = 0.01;          // 1 единица модели = 1 см -> переводим в метры
double correctionCoefficient = 3.0; // Коэффициент извилистости пути (обход мебели и т.д.)

// ВАЖНО: Используем твои кастомные методы getNodeX и getNodeY
// Предполагается, что эти методы принимают объект Node и возвращают double
double x1 = getNodeX(nodeA);
double y1 = getNodeY(nodeA);
double x2 = getNodeX(nodeB);
double y2 = getNodeY(nodeB);

// Расчет расстояния по теореме Пифагора
double distanceUnits = Utilities.getDistance(x1, y1, x2, y2);

return distanceUnits * scaleFactor * correctionCoefficient;
]]></Body>
				</Function>
			</Functions>
